rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isClinician() {
      return isSignedIn()
        && (
          request.auth.token.role == 'clinician'
          || (
            firestore.exists(/databases/(default)/documents/clinicians/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/clinicians/$(request.auth.uid)).data.role == 'clinician'
          )
        );
    }

    function isCenter() {
      return isSignedIn()
        && (
          request.auth.token.role == 'center'
          || (
            firestore.exists(/databases/(default)/documents/centers/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/centers/$(request.auth.uid)).data.role == 'center'
          )
        );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isOfficialSpecialistImageUpload() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    function isOfficialCenterImageUpload() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    match /centers/{uid}/official/identity_image {
      allow read: if true;
      allow create, update: if isCenter()
        && isOwner(uid)
        && isOfficialCenterImageUpload();
      allow delete: if false;
    }

    match /clinicians/{uid}/official/profile_image {
      allow read: if true;
      allow create, update: if isClinician()
        && isOwner(uid)
        && isOfficialSpecialistImageUpload();
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
