rules_version = '2';

// MASTER CORE role doctrine:
// Firestore authorization depends on custom claims, not UI role documents.
// AccountAccessService and role documents are app-side UI/UX gates only.
// Opening a screen in the app does not guarantee Firestore read/write access.
// Server SDK tooling is a privileged ops layer.
// QA bot writes are privileged ops behavior, not client/app behavior.
// Do not broaden rules to hide a custom-claims mismatch.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function uid() {
      return request.auth.uid;
    }

    function hasRole(roleName) {
      return signedIn() && request.auth.token.role == roleName;
    }

    function isOwner() {
      return hasRole('owner');
    }

    function isMonitoringOperator() {
      return hasRole('monitoring_operator');
    }

    function isRegistrySteward() {
      return hasRole('registry_steward');
    }

    function isDeclarationReviewer() {
      return hasRole('declaration_reviewer');
    }

    function isSupportObserver() {
      return hasRole('support_observer');
    }

    function protectedAccountFields() {
      return [
        'role',
        'isBlocked',
        'blockedAt',
        'blockedBy',
        'blockReason'
      ];
    }

    function noProtectedAccountFieldChange() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(protectedAccountFields());
    }

    function ownDoc(docId) {
      return signedIn() && docId == uid();
    }

    function visibilityReady() {
      return resource != null
        && resource.data.visibilityReadiness == 'ready'
        && resource.data.isBlocked != true;
    }

    function notVisibilityReady() {
      return resource != null
        && (
          !resource.data.keys().hasAny(['visibilityReadiness'])
          || resource.data.visibilityReadiness != 'ready'
        );
    }

    function clinicianCreateValid(docId) {
      return ownDoc(docId)
        && request.resource.data.role == 'clinician'
        && request.resource.data.isBlocked != true
        && request.resource.data.visibilityReadiness == 'incomplete';
    }

    function clinicianSelfRegistrationFields() {
      return [
        'displayName',
        'fullName',
        'fullDisplayNameAr',
        'fullDisplayNameEn',
        'email',
        'professionalTitle',
        'professionalTitleKey',
        'professionalTitleLabelAr',
        'professionalTitleLabelEn',
        'specialty',
        'specialtyKey',
        'specialtyLabel',
        'phoneNumber',
        'countryCode',
        'photoUrl',
        'photoAsset',
        'bio',
        'identityFileName',
        'certificateFileName',
        'extraFileName',
        'documentsSubmitted',
        'documentsUploadMode',
        'identityDocumentUrl',
        'certificateDocumentUrl',
        'extraDocumentUrl',
        'declarationSignals',
        'visibilityReadiness',
        'missingSignals',
        'completedSignals',
        'readinessUpdatedAt',
        'readinessSource',
        'updatedAt',
        'createdAt'
      ];
    }

    function clinicianSelfUpdateValid(docId) {
      return ownDoc(docId)
        && noProtectedAccountFieldChange()
        && notVisibilityReady()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(clinicianSelfRegistrationFields());
    }

    function centerCreateValid(docId) {
      return ownDoc(docId)
        && request.resource.data.role == 'center'
        && request.resource.data.isBlocked != true
        && request.resource.data.visibilityReadiness == 'incomplete';
    }

    function centerSelfRegistrationFields() {
      return [
        'name',
        'centerName',
        'displayName',
        'email',
        'category',
        'categoryLabelAr',
        'categoryLabelEn',
        'centerType',
        'centerTypeLabelAr',
        'centerTypeLabelEn',
        'sortOrder',
        'managerName',
        'phone',
        'phoneNumber',
        'whatsapp',
        'whatsappNumber',
        'countryCode',
        'city',
        'area',
        'address',
        'description',
        'hasDetoxUnit',
        'galleryItems',
        'galleryImages',
        'imageUrl',
        'coverImageUrl',
        'imagesReady',
        'accommodationCosts',
        'autismCareCosts',
        'centerCapabilities',
        'signalSchemaVersion',
        'services',
        'pricingReady',
        'documentItems',
        'documentsReady',
        'identityDocumentUrl',
        'licenseDocumentUrl',
        'commercialDocumentUrl',
        'taxDocumentUrl',
        'identityFileName',
        'licenseFileName',
        'commercialFileName',
        'taxFileName',
        'documentsUploadMode',
        'declarationSignals',
        'visibilityReadiness',
        'missingSignals',
        'completedSignals',
        'readinessUpdatedAt',
        'readinessSource',
        'updatedAt',
        'createdAt'
      ];
    }

    function centerSelfUpdateValid(docId) {
      return ownDoc(docId)
        && noProtectedAccountFieldChange()
        && notVisibilityReady()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(centerSelfRegistrationFields());
    }

    match /clinicians/{clinicianId} {
      allow read: if isDeclarationReviewer()
        || (signedIn() && clinicianId == uid())
        || visibilityReady();
      allow create: if clinicianCreateValid(clinicianId);
      allow update: if clinicianSelfUpdateValid(clinicianId);
      allow delete: if false;
    }

    match /clinicians/{clinicianId}/profile/{profileId} {
      allow read: if isDeclarationReviewer() || ownDoc(clinicianId);
      allow create, update: if ownDoc(clinicianId)
        && profileId == 'current'
        && request.resource.data.ownerUid == uid()
        && request.resource.data.profileType == 'specialist'
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if false;
    }

    match /centers/{centerId} {
      allow read: if isDeclarationReviewer()
        || (signedIn() && centerId == uid())
        || visibilityReady();
      allow create: if centerCreateValid(centerId);
      allow update: if centerSelfUpdateValid(centerId);
      allow delete: if false;
    }

    match /centers/{centerId}/profile/{profileId} {
      allow read: if isDeclarationReviewer() || ownDoc(centerId);
      allow create, update: if ownDoc(centerId)
        && profileId == 'current'
        && request.resource.data.ownerUid == uid()
        && request.resource.data.profileType == 'center'
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if false;
    }

    match /clinician_profile_change_requests/{requestId} {
      allow read: if isDeclarationReviewer();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /center_profile_change_requests/{requestId} {
      allow read: if isDeclarationReviewer();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /support_requests/{requestId} {
      allow get, list: if isSupportObserver()
        || (signedIn() && resource.data.createdByUid == uid());
      allow create: if signedIn()
        && request.resource.data.createdByUid == uid()
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'structured_support';
      allow update: if false;
      allow delete: if false;
    }

    match /system_domains/{docId} {
      allow read: if isOwner() || isRegistrySteward();
      allow write: if false;
      allow delete: if false;
    }

    match /signal_events/{signalId} {
      allow get: if signedIn() && (resource.data.actorId == uid() || isOwner() || isMonitoringOperator() || isSupportObserver());
      allow list: if signedIn()
        && (
          resource.data.actorId == uid()
          || isOwner()
          || isMonitoringOperator()
          || isSupportObserver()
        );
      allow create: if ((
            signedIn()
            && request.resource.data.actorId == uid()
          )
          || (
            request.resource.data.actorRole in ['session', 'visitor']
            && isNonEmptyString(request.resource.data.actorId)
          ))
        && request.resource.data.signalId == signalId
        && request.resource.data.keys().hasOnly([
          'signalId',
          'signalType',
          'signalCategory',
          'signalDomain',
          'signalSource',
          'actorId',
          'actorRole',
          'targetType',
          'targetId',
          'timestamp',
          'routingTarget',
          'retentionClass',
          'privacyLevel',
          'signalVersion',
          'createdAt'
        ]);
      allow update, delete: if false;
    }

    function archiveSignalEventAllowedKeys() {
      return [
        'event_id',
        'source_section_code',
        'source_outbox_plug',
        'destination_section_code',
        'destination_inbox_plug',
        'archive_destination_code',
        'package_family',
        'signal_code',
        'magnet_code',
        'privacy_class',
        'retention_class',
        'payload_minimal',
        'created_at',
        'guard_status',
        'quarantine_reason',
        'trace_id'
      ];
    }

    function archiveSignalPayloadAllowedKeys() {
      return [
        'source_screen',
        'source_widget',
        'action',
        'runtime_version'
      ];
    }

    function firstControlledArchiveSignalValid(eventId) {
      return request.resource.data.keys().hasOnly(archiveSignalEventAllowedKeys())
        && request.resource.data.event_id == eventId
        && request.resource.data.source_section_code == 'SEC-CV2'
        && request.resource.data.source_outbox_plug == 'PLG-CV2-OUT'
        && request.resource.data.destination_section_code == 'SEC-ARC'
        && request.resource.data.destination_inbox_plug == 'PLG-ARC-IN'
        && request.resource.data.archive_destination_code == 'ARC-SIG-CV2-SHOWCASE-001'
        && request.resource.data.package_family == 'signal_event'
        && request.resource.data.signal_code == 'CV2_SIG_OPEN_LIBRARY'
        && request.resource.data.magnet_code == 'CV2-MAG-LIBRARY-INTEREST'
        && request.resource.data.privacy_class == 'anonymous_navigation_signal'
        && request.resource.data.retention_class == 'operational_summary'
        && request.resource.data.guard_status == 'accepted'
        && request.resource.data.quarantine_reason == 'NONE'
        && request.resource.data.created_at is timestamp
        && request.resource.data.payload_minimal is map
        && request.resource.data.payload_minimal.keys().hasOnly(archiveSignalPayloadAllowedKeys())
        && request.resource.data.payload_minimal.source_screen == 'Commercial V2 Web Showcase'
        && request.resource.data.payload_minimal.source_widget == 'library showcase card'
        && request.resource.data.payload_minimal.action == 'open_section'
        && request.resource.data.payload_minimal.runtime_version == 'commercial-v2-c2-local-v1';
    }

    function residentialToolSignalCodes() {
      return [
        'R.T.001.OPEN',
        'R.T.005.OPEN',
        'R.T.006.OPEN',
        'R.T.007.OPEN'
      ];
    }

    function firstResidentialToolArchiveSignalValid(eventId) {
      return request.resource.data.keys().hasOnly(archiveSignalEventAllowedKeys())
        && request.resource.data.event_id == eventId
        && request.resource.data.source_section_code == 'SEC-RES'
        && request.resource.data.source_outbox_plug == 'PLG-RES-OUT'
        && request.resource.data.destination_section_code == 'SEC-ARC'
        && request.resource.data.destination_inbox_plug == 'PLG-ARC-IN'
        && request.resource.data.archive_destination_code == 'ARC-SIG-RES-TOOLS-001'
        && request.resource.data.package_family == 'signal_event'
        && request.resource.data.signal_code in residentialToolSignalCodes()
        && request.resource.data.magnet_code == 'RES-MAG-TOOLS'
        && request.resource.data.privacy_class == 'anonymous_navigation_signal'
        && request.resource.data.retention_class == 'operational_summary'
        && request.resource.data.guard_status == 'accepted'
        && request.resource.data.quarantine_reason == 'NONE'
        && request.resource.data.created_at is timestamp
        && request.resource.data.payload_minimal is map
        && request.resource.data.payload_minimal.keys().hasOnly(archiveSignalPayloadAllowedKeys())
        && isNonEmptyString(request.resource.data.payload_minimal.source_screen)
        && isNonEmptyString(request.resource.data.payload_minimal.source_widget)
        && isNonEmptyString(request.resource.data.payload_minimal.action)
        && request.resource.data.payload_minimal.runtime_version == 'residential-r11-local-v1';
    }

    function firstLibraryHomeSignalValid(eventId) {
      return request.resource.data.keys().hasOnly(archiveSignalEventAllowedKeys())
        && request.resource.data.event_id == eventId
        && request.resource.data.source_section_code == 'SEC-LIB'
        && request.resource.data.source_outbox_plug == 'PLG-LIB-OUT'
        && request.resource.data.destination_section_code == 'SEC-ARC'
        && request.resource.data.destination_inbox_plug == 'PLG-ARC-IN'
        && request.resource.data.archive_destination_code == 'ARC-SIG-LIB-HOME-001'
        && request.resource.data.package_family == 'signal_event'
        && request.resource.data.signal_code in [
          'L.S.001.VIEW',
          'L.C.001.OPEN'
        ]
        && request.resource.data.magnet_code == 'LIB-MAG-HOME'
        && request.resource.data.privacy_class == 'anonymous_navigation_signal'
        && request.resource.data.retention_class == 'operational_summary'
        && request.resource.data.guard_status == 'accepted'
        && request.resource.data.quarantine_reason == 'NONE'
        && request.resource.data.created_at is timestamp
        && request.resource.data.payload_minimal is map
        && request.resource.data.payload_minimal.keys().hasOnly(archiveSignalPayloadAllowedKeys())
        && isNonEmptyString(request.resource.data.payload_minimal.source_screen)
        && isNonEmptyString(request.resource.data.payload_minimal.source_widget)
        && isNonEmptyString(request.resource.data.payload_minimal.action)
        && request.resource.data.payload_minimal.runtime_version == 'library-l2-local-v1';
    }

    function firstLibrarySpecialistsSignalValid(eventId) {
      return request.resource.data.keys().hasOnly(archiveSignalEventAllowedKeys())
        && request.resource.data.event_id == eventId
        && request.resource.data.source_section_code == 'SEC-LIB-SP'
        && request.resource.data.source_outbox_plug == 'PLG-LIB-SP-OUT'
        && request.resource.data.destination_section_code == 'SEC-ARC'
        && request.resource.data.destination_inbox_plug == 'PLG-ARC-IN'
        && request.resource.data.archive_destination_code == 'ARC-SIG-LIB-SP-001'
        && request.resource.data.package_family == 'signal_event'
        && request.resource.data.signal_code in [
          'L.S.003.VIEW',
          'L.C.003.OPEN'
        ]
        && request.resource.data.magnet_code == 'LIB-MAG-SPECIALISTS'
        && request.resource.data.privacy_class == 'anonymous_navigation_signal'
        && request.resource.data.retention_class == 'operational_summary'
        && request.resource.data.guard_status == 'accepted'
        && request.resource.data.quarantine_reason == 'NONE'
        && request.resource.data.created_at is timestamp
        && request.resource.data.payload_minimal is map
        && request.resource.data.payload_minimal.keys().hasOnly(archiveSignalPayloadAllowedKeys())
        && isNonEmptyString(request.resource.data.payload_minimal.source_screen)
        && isNonEmptyString(request.resource.data.payload_minimal.source_widget)
        && isNonEmptyString(request.resource.data.payload_minimal.action)
        && request.resource.data.payload_minimal.runtime_version == 'library-l2-local-v1';
    }

    function firstLibraryCentersSignalValid(eventId) {
      return request.resource.data.keys().hasOnly(archiveSignalEventAllowedKeys())
        && request.resource.data.event_id == eventId
        && request.resource.data.source_section_code == 'SEC-LIB-CTR'
        && request.resource.data.source_outbox_plug == 'PLG-LIB-CTR-OUT'
        && request.resource.data.destination_section_code == 'SEC-ARC'
        && request.resource.data.destination_inbox_plug == 'PLG-ARC-IN'
        && request.resource.data.archive_destination_code == 'ARC-SIG-LIB-CTR-001'
        && request.resource.data.package_family == 'signal_event'
        && request.resource.data.signal_code in [
          'L.S.004.VIEW',
          'L.C.004.OPEN'
        ]
        && request.resource.data.magnet_code == 'LIB-MAG-CENTERS'
        && request.resource.data.privacy_class == 'anonymous_navigation_signal'
        && request.resource.data.retention_class == 'operational_summary'
        && request.resource.data.guard_status == 'accepted'
        && request.resource.data.quarantine_reason == 'NONE'
        && request.resource.data.created_at is timestamp
        && request.resource.data.payload_minimal is map
        && request.resource.data.payload_minimal.keys().hasOnly(archiveSignalPayloadAllowedKeys())
        && isNonEmptyString(request.resource.data.payload_minimal.source_screen)
        && isNonEmptyString(request.resource.data.payload_minimal.source_widget)
        && isNonEmptyString(request.resource.data.payload_minimal.action)
        && request.resource.data.payload_minimal.runtime_version == 'library-l2-local-v1';
    }

    match /archive_signal_events/{eventId} {
      allow read: if isOwner() || isMonitoringOperator();
      allow create: if firstControlledArchiveSignalValid(eventId)
        || firstResidentialToolArchiveSignalValid(eventId)
        || firstLibraryHomeSignalValid(eventId)
        || firstLibrarySpecialistsSignalValid(eventId)
        || firstLibraryCentersSignalValid(eventId);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
